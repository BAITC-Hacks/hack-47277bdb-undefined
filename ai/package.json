{
  "name": "ekt-ai-service",
  "version": "0.1.0",
  "private": true,
  "description": "Retired migration reference only. The assistant runs inside ../backend.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node legacy-disabled.cjs",
    "build": "node legacy-disabled.cjs",
    "start": "node legacy-disabled.cjs",
    "db:migrate": "node legacy-disabled.cjs",
    "db:migrate:prod": "node legacy-disabled.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings=0",
    "format": "prettier --write .",
