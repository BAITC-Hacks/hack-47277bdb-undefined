PORT=3000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ekt_store?schema=public"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

CLIENT_URL="http://localhost:5173"

BCRYPT_ROUNDS=10

# Optional assistant intent classification. Keys are backend-only; never VITE_*.
# Deterministic Kazakh/Russian assistant works without a paid model request.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
ASSISTANT_LLM_ENABLED=false
ASSISTANT_PROPOSAL_TTL_SECONDS=900

# Optional demo administrator. If either value is empty, seed skips admin creation.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional separate PostgreSQL database for Jest; otherwise .env DATABASE_URL is used.
# TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ekt_store_test?schema=public"
