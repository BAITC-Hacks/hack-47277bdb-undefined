PORT=3000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ekt_store?schema=public"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

CLIENT_URL="http://localhost:5173"

BCRYPT_ROUNDS=10

# Optional demo administrator. If either value is empty, seed skips admin creation.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional separate PostgreSQL database for Jest; otherwise .env DATABASE_URL is used.
# TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ekt_store_test?schema=public"
